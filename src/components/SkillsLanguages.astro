---
import { defaultLocale, t, type Locale } from '../i18n';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const spokenLanguages = t('spoken_languages', locale);

const skills = t('technical_skills', locale);
---

<section class="skills-languages" id="skills" aria-label={t('skills_label', locale)}>
	<div class="section-heading">
		<h2 class="eyebrow">{t('skills_title', locale)}</h2>
	</div>

	<div class="skill-groups">
        {skills.map(group => (
            <div>
                <h3>{group.label}</h3>
                <ul>{group.values.map(skill => <li>{skill}</li>)}</ul>
            </div>
        ))}
    </div>

	<ul class="spoken-languages" aria-label={t('spoken_languages_label', locale)}>
		{
			spokenLanguages.map((language) => (
				<li class="spoken-language">
					<span class={`fi ${language.flag}`} aria-hidden="true"></span>
					<span class="spoken-language-name">{language.name}</span>
					<span class="spoken-language-level">{language.level}</span>
				</li>
			))
		}
	</ul>
</section>

<style>
.skill-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.skill-groups>div{padding:1.25rem;border:1px solid var(--color-border);border-radius:8px;background:var(--color-bg-secondary)}.skill-groups h3{margin:0 0 1rem;font-size:1rem}.skill-groups ul{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin:0}.skill-groups li{border:1px solid var(--color-border);border-radius:5px;padding:.4rem .65rem;color:var(--color-text-muted)}@media(max-width:600px){.skill-groups{grid-template-columns:1fr}}

	.skills-languages {
		padding: clamp(4rem, 8vw, 7rem) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.section-heading {
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--color-accent);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.spoken-languages {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.85rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.spoken-language {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-bg-secondary);
		padding: 0.5rem 1rem;
		color: var(--color-text);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.spoken-language .fi {
		width: 1.3rem;
		border-radius: 2px;
	}

	.spoken-language-name {
		color: var(--color-text);
	}

	.spoken-language-level {
		color: var(--color-success);
		font-weight: 800;
	}

	@media (max-width: 520px) {
		.spoken-languages {
			gap: 0.6rem;
		}

		.spoken-language {
			padding: 0.45rem 0.85rem;
			font-size: 0.88rem;
		}
	}
</style>
