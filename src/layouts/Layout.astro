---
import "flag-icons/css/flag-icons.min.css";
import profile from '../data/professional-profile.json';
import { defaultLocale, t, type Locale } from '../i18n';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const canonical = `https://martivilas.com${locale === 'en' ? '/en/' : '/'}`;
const structuredData = {
 '@context': 'https://schema.org', '@type': 'ProfilePage', '@id': canonical + '#profile', url: canonical, inLanguage: locale,
 mainEntity: { '@type': 'Person', '@id': 'https://martivilas.com/#person', name: profile.identity.name,
  url: profile.identity.website, jobTitle: 'Frontend / Full-Stack Developer',
  worksFor: { '@type': 'Organization', name: profile.employment.company },
  homeLocation: { '@type': 'Place', name: profile.identity.location },
  sameAs: [profile.identity.github, profile.identity.linkedin],
  knowsAbout: ['React', 'TypeScript', 'Node.js', 'SQL', 'Web development', 'API integration'],
  knowsLanguage: ['ca', 'es', 'en'], alumniOf: { '@type': 'EducationalOrganization', name: 'Institut Tecnològic de Barcelona' }
 }
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={t('meta_description', locale)}
		/>
		<title>{t('page_title', locale)}</title>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href="https://martivilas.com/" />
        <link rel="alternate" hreflang="en" href="https://martivilas.com/en/" />
        <link rel="alternate" hreflang="x-default" href="https://martivilas.com/en/" />
        <meta property="og:type" content="profile" />
        <meta property="og:title" content={t('page_title', locale)} />
        <meta property="og:description" content={t('meta_description', locale)} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'es_ES'} />
        <meta property="og:locale:alternate" content={locale === 'en' ? 'es_ES' : 'en_GB'} />
        <meta property="og:image" content="https://martivilas.com/Logo-marti.jpeg" />
        <meta property="og:image:alt" content="Martí Vilàs" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={t('page_title', locale)} />
        <meta name="twitter:description" content={t('meta_description', locale)} />
        <meta name="twitter:image" content="https://martivilas.com/Logo-marti.jpeg" />
        <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\u003c')} />
		<script is:inline>
			let savedTheme = null;
            try { savedTheme = localStorage.getItem('theme'); } catch {}
			document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
		</script>
	</head>
	<body>
        <a class="skip-link" href="#inicio">{t('skip_content', locale)}</a>
		<slot />
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		--color-bg: #0b1220;
		--color-bg-secondary: #111c2e;
		--color-bg-tertiary: #0f172a;
		--color-card: #111c2e;
		--color-card-alt: #0f172a;
		--color-primary: #2563eb;
		--color-primary-hover: #1d4ed8;
		--color-accent: #38bdf8;
		--color-accent-rgb: 56, 189, 248;
		--color-accent-soft: rgba(var(--color-accent-rgb), 0.12);
		--color-text: #eaf2ff;
		--color-text-muted: #94a3b8;
		--color-border: #1e293b;
		--color-success: #22c55e;
		--color-button-text: #eaf2ff;
		--color-shadow: rgba(0, 0, 0, 0.26);
		--color-shadow-strong: rgba(0, 0, 0, 0.42);
		--color-header-bg: rgba(11, 18, 32, 0.88);
		--color-header-text: #d7e8ff;
		--color-header-text-hover: #ffffff;
		--color-hero-overlay-start: rgba(11, 18, 32, 0.96);
		--color-hero-overlay-end: rgba(17, 28, 46, 0.86);
		--color-chat-bg: rgba(11, 18, 32, 0.98);
		background: var(--color-bg);
		color: var(--color-text);
	}

	:root[data-theme="light"] {
		color-scheme: light;
		--color-bg: #f8fafc;
		--color-bg-secondary: #ffffff;
		--color-bg-tertiary: #eef6ff;
		--color-card: #ffffff;
		--color-card-alt: #f1f7ff;
		--color-primary: #2563eb;
		--color-primary-hover: #1d4ed8;
		--color-accent: #0369a1;
		--color-accent-rgb: 2, 132, 199;
		--color-accent-soft: #dbeafe;
		--color-text: #0f172a;
		--color-text-muted: #475569;
		--color-border: #d7e5f5;
		--color-success: #15803d;
		--color-button-text: #ffffff;
		--color-shadow: rgba(15, 23, 42, 0.08);
		--color-shadow-strong: rgba(15, 23, 42, 0.16);
		--color-header-bg: rgba(255, 255, 255, 0.88);
		--color-header-text: #0f172a;
		--color-header-text-hover: #1d4ed8;
		--color-hero-overlay-start: rgba(248, 250, 252, 0.96);
		--color-hero-overlay-end: rgba(238, 246, 255, 0.88);
		--color-chat-bg: rgba(255, 255, 255, 0.98);
	}

	:global(:focus-visible) { outline: 3px solid var(--color-accent); outline-offset: 4px; }
	:global(section[id]) { scroll-margin-top: 170px; }
	.skip-link { position: fixed; top: -100px; left: 1rem; z-index: 100; padding: 1rem; background: var(--color-bg-secondary); color: var(--color-text); }
	.skip-link:focus { top: 1rem; }
	@media (prefers-reduced-motion: reduce) { :global(*), :global(*::before), :global(*::after) { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; } }
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		scroll-behavior: smooth;
	}

	body {
		background: linear-gradient(
			135deg,
			var(--color-bg) 0%,
			var(--color-bg-tertiary) 55%,
			var(--color-bg-secondary) 100%
		);
		overflow-x: hidden;
	}

	:global(*) {
		box-sizing: border-box;
	}

	a {
		color: inherit;
	}
</style>
